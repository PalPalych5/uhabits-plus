<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Statistics.BottomSheetDialogTheme" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Statistics.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="Statistics.BottomSheet" parent="Widget.Design.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Statistics.FilterButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/contrast100</item>
        <item name="backgroundTint">?attr/cardBgColor</item>
        <item name="cornerRadius">12dp</item>
        <item name="iconTint">?attr/contrast100</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="strokeColor">?attr/contrast40</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Statistics.FilterChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">32dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="android:textColor">?attr/contrast100</item>
        <item name="android:textSize">12sp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">8dp</item>
        <item name="chipStrokeColor">?attr/contrast40</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Statistics.FilterSectionTitle" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/contrast80</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Statistics.FilterActionButton" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetTop">0dp</item>
    </style>

    <style name="Statistics.FilterResetButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/contrast100</item>
        <item name="backgroundTint">?attr/cardBgColor</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="strokeColor">?attr/contrast40</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
