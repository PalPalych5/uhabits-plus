<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tasksRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top App Bar: Compact (48dp) title + overflow -->
    <LinearLayout
        android:id="@+id/tasksHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvTasksTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tasks_title"
            android:textSize="22sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false" />

        <ImageButton
            android:id="@+id/btnTasksOverflow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_toolbar_more_vertical"
            android:contentDescription="Действия со списком" />
    </LinearLayout>

    <!-- Multi-selection Action Bar: Compact (48dp) -->
    <LinearLayout
        android:id="@+id/tasksSelectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnSelectionClose"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Выйти из режима выбора" />

        <TextView
            android:id="@+id/tvSelectionCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="middle"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false" />

        <ImageButton
            android:id="@+id/btnSelectionDue"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_cat_calendar"
            android:contentDescription="Изменить срок выбранных" />

        <ImageButton
            android:id="@+id/btnSelectionContainer"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_cat_folder"
            android:contentDescription="Переместить выбранные в раздел" />

        <ImageButton
            android:id="@+id/btnSelectionComplete"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_action_check"
            android:contentDescription="Завершить выбранные" />

        <ImageButton
            android:id="@+id/btnSelectionDelete"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings_trash"
            android:contentDescription="Удалить выбранные" />

        <ImageButton
            android:id="@+id/btnSelectionMore"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_toolbar_more_vertical"
            android:contentDescription="Действия с задачей"
            android:visibility="gone" />
    </LinearLayout>

    <!-- List Info line: Count on the left, Date on the right -->
    <LinearLayout
        android:id="@+id/layoutListInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="56dp"
        android:paddingEnd="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvTasksSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:text="0 задач" />

        <TextView
            android:id="@+id/tvTasksTagFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:text="Теги"
            android:maxLines="1"
            android:ellipsize="end"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Фильтр по тегам" />

        <TextView
            android:id="@+id/tvTasksDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Content Area: RecyclerView + Empty View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="64dp" />

        <!-- Empty state view -->
        <LinearLayout
            android:id="@+id/layoutEmptyTasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivEmptyIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_cat_list_todo" />

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:text="Нет задач" />

            <TextView
                android:id="@+id/tvEmptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:gravity="center"
                android:text="Добавьте задачу через строку внизу" />
        </LinearLayout>
    </FrameLayout>

    <!-- Quick Add Docked Bar at the bottom -->
    <LinearLayout
        android:id="@+id/layoutQuickAddContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Hairline Divider -->
        <View
            android:id="@+id/quickAddDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <!-- Collapsed Persistent Row: "+ Добавить задачу…" -->
        <LinearLayout
            android:id="@+id/layoutQuickAddCollapsed"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivQuickAddIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_toolbar_add" />

            <TextView
                android:id="@+id/tvQuickAddCollapsedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:text="Добавить задачу…" />
        </LinearLayout>

        <!-- Expanded Composer View (above IME) -->
        <LinearLayout
            android:id="@+id/layoutQuickAddExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Input Row: field + expand chevron + submit button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <EditText
                    android:id="@+id/etQuickAddTitle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Добавить задачу…"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:singleLine="true" />

                <ImageButton
                    android:id="@+id/btnQuickAddExpand"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_chevron_up"
                    android:contentDescription="Развернуть в полный редактор" />

                <ImageButton
                    android:id="@+id/btnQuickAddSubmit"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:padding="10dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_toolbar_add"
                    android:contentDescription="Добавить" />
            </LinearLayout>

            <!-- Compact Metadata Options Row (40dp) -->
            <LinearLayout
                android:id="@+id/quickAddOptions"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/quickDue"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Задать срок"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/quickContainer"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginStart="8dp"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Входящие"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/quickTags"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginStart="8dp"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Теги"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
