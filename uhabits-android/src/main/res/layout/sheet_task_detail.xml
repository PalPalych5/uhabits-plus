<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/taskDetailRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Drag Handle -->
        <View
            android:id="@+id/viewDragHandle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- Title Row with Check button and Title input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <FrameLayout
                android:id="@+id/btnDetailCheck"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/viewDetailCheckCircle"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center" />

                <ImageView
                    android:id="@+id/ivDetailCheckmark"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_toolbar_check"
                    android:visibility="gone" />
            </FrameLayout>

            <EditText
                android:id="@+id/etDetailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Название задачи"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3" />
        </LinearLayout>

        <!-- Notes / Description -->
        <EditText
            android:id="@+id/etDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="44dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@null"
            android:hint="Заметки..."
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="5" />

        <View
            android:id="@+id/divider1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp" />

        <!-- Container Placement Selector Row -->
        <LinearLayout
            android:id="@+id/rowDetailContainer"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivDetailContainerIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_cat_navigation"
                android:layout_marginEnd="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Раздел:"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:layout_marginEnd="8dp" />

            <View
                android:id="@+id/viewDetailContainerDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvDetailContainerValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:text="Без раздела" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <!-- Planned Date Selector Row -->
        <LinearLayout
            android:id="@+id/rowDetailPlannedDate"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivDetailPlanIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_settings_clock_check"
                android:layout_marginEnd="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="План:"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvDetailPlannedDateValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:text="Не запланировано" />

            <ImageButton
                android:id="@+id/btnClearPlannedDate"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@null"
                android:src="@drawable/ic_close"
                android:contentDescription="Очистить дату"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Deadline Selector Row -->
        <LinearLayout
            android:id="@+id/rowDetailDeadline"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivDetailDeadlineIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_settings_bell_check"
                android:layout_marginEnd="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Дедлайн:"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvDetailDeadlineValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:text="Нет дедлайна" />

            <ImageButton
                android:id="@+id/btnClearDeadline"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@null"
                android:src="@drawable/ic_close"
                android:contentDescription="Очистить дедлайн"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:id="@+id/divider2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Subtasks Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Подзадачи"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvDetailSubtasksCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:text="0" />
        </LinearLayout>

        <!-- Subtasks RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDetailSubtasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- Add Subtask Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_toolbar_add" />

            <EditText
                android:id="@+id/etNewSubtaskTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Добавить подзадачу..."
                android:textSize="14sp"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:singleLine="true" />
        </LinearLayout>

        <View
            android:id="@+id/divider3"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp" />

        <!-- Bottom Actions (Delete Task, Save) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnDeleteTask"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Удалить задачу"
                android:textColor="#E53935" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnSaveTask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сохранить" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
