<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/taskDetailRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="0dp"
        android:focusableInTouchMode="true">

        <!-- Top Bar -->
        <View
            android:id="@+id/viewDragHandle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp" />

        <!-- Top Bar -->
        <FrameLayout
            android:id="@+id/layoutTopBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp">

            <!-- Create Mode Top Bar -->
            <RelativeLayout
                android:id="@+id/topBarCreate"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnDetailCollapse"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="4dp"
                    android:paddingEnd="12dp"
                    android:text="Свернуть"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvDetailSheetTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/btnDetailCollapse"
                    android:layout_toStartOf="@+id/btnDetailCreate"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Новая задача"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />

                <Button
                    android:id="@+id/btnDetailCreate"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Создать"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </RelativeLayout>

            <!-- Edit Mode Top Bar -->
            <RelativeLayout
                android:id="@+id/topBarEdit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDetailSaveStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:paddingStart="4dp"
                    android:text="Изменения сохранены"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />

                <ImageButton
                    android:id="@+id/btnDetailMore"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="12dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_toolbar_more_vertical"
                    android:contentDescription="Действия с задачей" />
            </RelativeLayout>
        </FrameLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/taskDetailScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

        <!-- 1. Title Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <FrameLayout
                android:id="@+id/btnDetailCheck"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Завершить или возобновить задачу"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/viewDetailCheckCircle"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center" />

                <ImageView
                    android:id="@+id/ivDetailCheckmark"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_action_check"
                    android:visibility="gone" />
            </FrameLayout>

            <EditText
                android:id="@+id/etDetailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:background="@null"
                android:hint="Название задачи"
                android:textSize="20sp"
                android:gravity="top|start"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:fontFamily="sans-serif-medium"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="6" />
        </LinearLayout>

        <!-- 2. Main Attributes Row (Срок и Раздел) immediately under Title -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/layoutDetailChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Due Chip -->
                <LinearLayout
                    android:id="@+id/chipDetailDue"
                    android:layout_width="wrap_content"
                    android:minWidth="0dp"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivDetailDueIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_cat_calendar" />

                    <TextView
                        android:id="@+id/tvDetailDueValue"
                        android:layout_width="wrap_content"
                        android:minWidth="0dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Задать срок" />

                    <ImageView
                        android:id="@+id/btnClearDue"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        android:contentDescription="Очистить срок" />
                </LinearLayout>

                <!-- Container Chip -->
                <LinearLayout
                    android:id="@+id/chipDetailContainer"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivDetailContainerIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_cat_folder" />

                    <TextView
                        android:id="@+id/tvDetailContainerValue"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Входящие" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Divider -->
        <View
            android:id="@+id/dividerAttributes"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp" />

        <!-- 3. Note Section (Заметка) -->
        <LinearLayout
            android:id="@+id/sectionNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvDetailDescriptionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Заметка"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:background="@null"
                android:gravity="top|start"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="3dp"
                android:hint="Добавить заметку…"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="10" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:id="@+id/dividerNote"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp" />

        <!-- 4. Subtasks Section (Подзадачи) -->
        <LinearLayout
            android:id="@+id/sectionSubtasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvDetailSubtasksLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Подзадачи"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvDetailSubtasksCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:text="0" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDetailSubtasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <ImageButton
                    android:id="@+id/ivAddSubtask"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Добавить подзадачу"
                    android:src="@drawable/ic_toolbar_add" />

                <EditText
                    android:id="@+id/etNewSubtaskTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:background="@null"
                    android:hint="Добавить подзадачу…"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textSize="14sp"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- 5. Focus Section (Сессии фокуса) - ONLY for existing tasks in Edit mode -->
        <LinearLayout
            android:id="@+id/rowDetailFocus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/layoutFocusPlay"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/ivDetailFocusIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_timer_play" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDetailFocusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Начать фокус"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvDetailFocus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 мин"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>
        </LinearLayout>

        <!-- Legacy Plan Decision (if needed in Edit mode) -->
        <LinearLayout
            android:id="@+id/cardLegacyPlanDecision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvLegacyPlanPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:text="Ранее запланировано:" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btnDismissLegacyPlan"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Отклонить"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnAcceptLegacyPlan"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Сделать сроком"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</LinearLayout>
