<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout android:id="@+id/taskDetailRoot"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp"
        android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="24dp"
        android:focusableInTouchMode="true">
        <View android:id="@+id/viewDragHandle"
            android:layout_width="36dp" android:layout_height="4dp"
            android:layout_gravity="center_horizontal" android:layout_marginBottom="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="top">
            <FrameLayout android:id="@+id/btnDetailCheck"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Завершить или возобновить задачу"
                android:clickable="true" android:focusable="true">
                <View android:id="@+id/viewDetailCheckCircle"
                    android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_gravity="center" />
                <ImageView android:id="@+id/ivDetailCheckmark"
                    android:layout_width="16dp" android:layout_height="16dp"
                    android:layout_gravity="center" android:src="@drawable/ic_action_check"
                    android:visibility="gone" />
            </FrameLayout>
            <EditText android:id="@+id/etDetailTitle"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minHeight="48dp" android:background="@null"
                android:hint="Название задачи" android:textSize="26sp" android:gravity="top|start"
                android:paddingTop="6dp" android:paddingBottom="8dp" android:paddingStart="0dp" android:paddingEnd="0dp"
                android:includeFontPadding="false" android:lineSpacingExtra="3dp"
                android:fontFamily="sans-serif-medium"
                android:inputType="textCapSentences|textMultiLine" android:maxLines="8" />
            <ImageButton android:id="@+id/btnDetailMore"
                android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_toolbar_more_vertical" android:contentDescription="Действия с задачей" />
        </LinearLayout>
        <EditText android:id="@+id/etDetailDescription"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="48dp" android:minHeight="48dp" android:gravity="top|start"
            android:layout_marginBottom="12dp" android:background="@null"
            android:paddingTop="4dp" android:paddingBottom="8dp" android:paddingStart="0dp" android:paddingEnd="8dp"
            android:includeFontPadding="false" android:lineSpacingExtra="4dp"
            android:hint="Добавить заметку…" android:textSize="15sp" android:fontFamily="sans-serif"
            android:inputType="textCapSentences|textMultiLine" android:maxLines="12" />
        <View android:id="@+id/divider1"
            android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginBottom="8dp" android:visibility="gone" />
        <LinearLayout android:id="@+id/rowDetailContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/ivDetailContainerIcon"
                android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="12dp"
                android:layout_marginEnd="16dp" android:src="@drawable/ic_cat_folder" />
            <View android:id="@+id/viewDetailContainerDot"
                android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="8dp" android:visibility="gone" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:paddingTop="8dp" android:paddingBottom="8dp">
                <TextView android:id="@+id/tvDetailContainerLabel"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Раздел" android:textSize="12sp" android:fontFamily="sans-serif" android:visibility="gone" />
                <TextView android:id="@+id/tvDetailContainerValue"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="0dp" android:paddingBottom="0dp" android:textSize="15sp" android:maxLines="2" android:ellipsize="end"
                android:fontFamily="sans-serif" android:text="Без раздела" />
            </LinearLayout>
            <ImageView android:id="@+id/ivDetailContainerChevron"
                android:layout_width="16dp" android:layout_height="16dp" android:layout_marginEnd="16dp"
                android:src="@drawable/ic_task_detail_chevron" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rowDetailPlannedDate"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/ivDetailPlanIcon"
                android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="12dp"
                android:layout_marginEnd="16dp" android:src="@drawable/ic_task_detail_plan" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:paddingTop="8dp" android:paddingBottom="8dp">
                <TextView android:id="@+id/tvDetailPlanLabel"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="План" android:textSize="12sp" android:fontFamily="sans-serif" android:visibility="gone" />
                <TextView android:id="@+id/tvDetailPlannedDateValue"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="0dp" android:paddingBottom="0dp" android:textSize="15sp" android:maxLines="2" android:ellipsize="end"
                android:fontFamily="sans-serif" android:text="Запланировать" />
            </LinearLayout>
            <ImageButton android:id="@+id/btnClearPlannedDate"
                android:layout_width="48dp" android:layout_height="48dp" android:padding="16dp"
                android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_close"
                android:contentDescription="Очистить плановую дату" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rowDetailDeadline"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/ivDetailDeadlineIcon"
                android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="12dp"
                android:layout_marginEnd="16dp" android:src="@drawable/ic_cat_flag" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:paddingTop="8dp" android:paddingBottom="8dp">
                <TextView android:id="@+id/tvDetailDeadlineLabel"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Дедлайн" android:textSize="12sp" android:fontFamily="sans-serif" android:visibility="gone" />
                <TextView android:id="@+id/tvDetailDeadlineValue"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="0dp" android:paddingBottom="0dp" android:textSize="15sp" android:maxLines="2" android:ellipsize="end"
                android:fontFamily="sans-serif" android:text="Добавить дедлайн" />
            </LinearLayout>
            <ImageButton android:id="@+id/btnClearDeadline"
                android:layout_width="48dp" android:layout_height="48dp" android:padding="16dp"
                android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_close"
                android:contentDescription="Очистить дедлайн" android:visibility="gone" />
        </LinearLayout>

        <View android:id="@+id/divider2"
            android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginStart="48dp" android:layout_marginTop="12dp" android:layout_marginBottom="20dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginStart="48dp" android:layout_marginEnd="12dp" android:layout_marginBottom="8dp">
            <TextView android:id="@+id/tvDetailSubtasksLabel"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Подзадачи" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/tvDetailSubtasksCount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:fontFamily="sans-serif" android:text="0" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvDetailSubtasks"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
            <ImageButton android:id="@+id/ivAddSubtask"
                android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Добавить подзадачу" android:src="@drawable/ic_toolbar_add" />
            <EditText android:id="@+id/etNewSubtaskTitle"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="48dp" android:background="@null" android:hint="Добавить подзадачу…"
                android:paddingStart="0dp" android:paddingEnd="0dp"
                android:textSize="15sp" android:imeOptions="actionDone" android:inputType="textCapSentences" android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
