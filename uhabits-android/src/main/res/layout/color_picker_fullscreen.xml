<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPickerBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPickerBackground"
        android:minHeight="@dimen/color_picker_toolbar_height"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="?attr/colorPickerOnSurface"
        app:title="@string/color_picker_title"
        app:titleCentered="true"
        app:titleTextColor="?attr/colorPickerOnSurface" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/color_picker_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/color_picker_horizontal_padding"
            android:paddingTop="@dimen/color_picker_content_top_padding"
            android:paddingEnd="@dimen/color_picker_horizontal_padding"
            android:paddingBottom="@dimen/color_picker_content_bottom_padding">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/color_picker_preview_card"
                android:layout_width="match_parent"
                android:layout_height="@dimen/color_picker_preview_height"
                app:cardBackgroundColor="?attr/colorPickerSurface"
                app:cardCornerRadius="@dimen/color_picker_card_radius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorPickerBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/color_picker_preview_padding">

                    <org.isoron.uhabits.activities.common.dialogs.ColorSwatchView
                        android:id="@+id/color_picker_preview_swatch"
                        android:layout_width="@dimen/color_picker_preview_swatch_size"
                        android:layout_height="@dimen/color_picker_preview_swatch_size"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/color_picker_preview_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/color_picker_preview_gap"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="?attr/colorPickerOnSurface"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <GridLayout
                android:id="@+id/color_picker_palette"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:alignmentMode="alignMargins"
                android:columnCount="6"
                android:rowCount="8"
                android:useDefaultMargins="false" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/custom_color_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/color_picker_custom_row_height"
                android:layout_marginTop="@dimen/color_picker_custom_margin"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="?attr/colorPickerSurface"
                app:cardCornerRadius="@dimen/color_picker_custom_radius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorPickerBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <org.isoron.uhabits.activities.common.dialogs.ColorSwatchView
                        android:id="@+id/custom_color_preview"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/custom_color"
                            android:textColor="?attr/colorPickerOnSurface"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/custom_color_modes"
                            android:textColor="?attr/colorPickerOnSurfaceVariant"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/custom_color_hex_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorPickerOnSurfaceVariant"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="?attr/colorPickerOnSurfaceVariant"
                        android:alpha="0.6"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/color_picker_reset"
                style="@style/ColorPicker.ResetButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/color_picker_reset_height"
                android:text="@string/reset_to_default_color"
                android:textColor="?attr/colorPickerOnSurfaceVariant" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/color_picker_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/color_picker_action_bar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/color_picker_horizontal_padding"
        android:paddingTop="@dimen/color_picker_action_padding"
        android:paddingEnd="@dimen/color_picker_horizontal_padding"
        android:paddingBottom="@dimen/color_picker_action_padding">

        <TextView
            android:id="@+id/color_picker_cancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/color_picker_action_height"
            android:layout_weight="1"
            android:alpha="1"
            android:background="@null"
            android:clickable="true"
            android:elevation="0dp"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0"
            android:text="@string/color_picker_cancel"
            android:textAllCaps="false"
            android:textColor="?attr/colorPickerOnSurface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/color_picker_apply"
            android:layout_width="0dp"
            android:layout_height="@dimen/color_picker_action_height"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@null"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0"
            android:text="@string/color_picker_apply"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="normal" />
    </LinearLayout>
</LinearLayout>
