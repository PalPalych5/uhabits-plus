<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/taskItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:gravity="top"
    android:paddingStart="8dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="?android:attr/selectableItemBackground">

    <FrameLayout
        android:id="@+id/btnTaskCheck"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Завершить или возобновить задачу"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/viewCheckCircle"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|center_horizontal" />

        <ImageView
            android:id="@+id/ivCheckmark"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_action_check"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layoutTaskContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:ellipsize="end"
            android:maxLines="2" />

        <LinearLayout
            android:id="@+id/layoutTaskMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTaskContext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12.5sp"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/tvTaskMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12.5sp"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
