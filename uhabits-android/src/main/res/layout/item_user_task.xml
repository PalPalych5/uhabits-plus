<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/taskItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="6dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Custom Check Button (48x48dp touch target, 20dp visible circle) -->
    <FrameLayout
        android:id="@+id/btnTaskCheck"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Завершить или возобновить задачу"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/viewCheckCircle"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center" />

        <ImageView
            android:id="@+id/ivCheckmark"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_action_check"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Task Content Area -->
    <LinearLayout
        android:id="@+id/layoutTaskContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:fontFamily="sans-serif"
            android:ellipsize="end"
            android:maxLines="2" />

        <!-- Clean Metadata Row (Concept A: plain text with dot separator, no capsule chips) -->
        <LinearLayout
            android:id="@+id/layoutTaskMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/viewContainerDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="5dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTaskMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
