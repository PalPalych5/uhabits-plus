<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/taskItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="afterDescendants">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeTaskRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Legacy Views kept for fallback and testing backward compatibility -->
    <LinearLayout
        android:id="@+id/layoutLegacyTaskRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:gravity="top"
        android:paddingStart="6dp"
        android:paddingEnd="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:background="?android:attr/selectableItemBackground">

        <FrameLayout
            android:id="@+id/btnTaskCheck"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Завершить или возобновить задачу"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/viewCheckCircle"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|center_horizontal" />

            <ImageView
                android:id="@+id/ivCheckmark"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_action_check"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/layoutTaskContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="2dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="4"
                android:lineSpacingExtra="2.5dp"
                android:lineSpacingMultiplier="1.12" />

            <LinearLayout
                android:id="@+id/layoutTaskMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTaskContext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvTaskMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:lineSpacingMultiplier="1.1"
                    android:fontFeatureSettings="tnum" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnTaskMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|center_horizontal"
            android:contentDescription="Действия с задачей"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivTaskMore"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_toolbar_more_vertical" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
