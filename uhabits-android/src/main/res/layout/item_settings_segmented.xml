<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="@dimen/settings_detail_row_min_height"
        android:paddingStart="@dimen/settings_detail_padding_start"
        android:paddingEnd="@dimen/settings_detail_padding_end"
        android:paddingTop="@dimen/settings_detail_padding_vertical"
        android:paddingBottom="@dimen/settings_detail_padding_vertical">

        <ImageView
            android:id="@+id/rowIcon"
            android:layout_width="@dimen/settings_detail_icon_size"
            android:layout_height="@dimen/settings_detail_icon_size"
            android:layout_marginEnd="@dimen/settings_detail_icon_gap"
            android:tint="?attr/contrast60"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:textSize="15sp"
            android:textColor="?attr/contrast100" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/segmentedContainer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/settings_detail_row_divider_start"
        android:layout_marginEnd="@dimen/settings_detail_divider_end"
        android:layout_marginBottom="@dimen/settings_detail_padding_vertical"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_segmented_control"
        android:padding="2dp">

            <TextView
                android:id="@+id/segmentSystem"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/segmentLight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/segmentDark"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/segmentAmoled"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
    </LinearLayout>

    <View
        android:id="@+id/rowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/settings_detail_row_divider_start"
        android:layout_marginEnd="@dimen/settings_detail_divider_end"
        android:background="?attr/contrast20" />
</LinearLayout>
