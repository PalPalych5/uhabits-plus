<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/statisticsFiltersSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/cardBgColor"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/statisticsFiltersScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp">

            <View
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/statistics_bottom_sheet_handle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/statistics_filters_title"
                android:textColor="?attr/contrast100"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Statistics.FilterSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/statistics_filters_sphere" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/sphereChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                app:chipSpacingHorizontal="4dp"
                app:chipSpacingVertical="0dp"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                style="@style/Statistics.FilterSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/statistics_filters_status" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/statusChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                app:chipSpacingHorizontal="4dp"
                app:chipSpacingVertical="0dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/statusAllChip"
                    style="@style/Statistics.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/reports_filter_all_habits" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/statusActiveChip"
                    style="@style/Statistics.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/statistics_filters_active" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/statusArchivedChip"
                    style="@style/Statistics.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/statistics_filters_archived" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                style="@style/Statistics.FilterSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/statistics_filters_goal_type" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/goalTypeChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                app:chipSpacingHorizontal="4dp"
                app:chipSpacingVertical="0dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/goalTypeAllChip"
                    style="@style/Statistics.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/statistics_filters_all_types" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/goalTypeBooleanChip"
                    style="@style/Statistics.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/statistics_filters_boolean" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/goalTypeNumericalChip"
                    style="@style/Statistics.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/statistics_filters_numerical" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                style="@style/Statistics.FilterSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/statistics_filters_tier" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/tierChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                app:chipSpacingHorizontal="4dp"
                app:chipSpacingVertical="0dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/tierAllChip"
                    style="@style/Statistics.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/statistics_filters_all_tiers" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/tierMinimumChip"
                    style="@style/Statistics.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/day_tier_badge_minimum" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/tierNormalChip"
                    style="@style/Statistics.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/day_tier_badge_normal" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/tierIdealChip"
                    style="@style/Statistics.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/day_tier_badge_ideal" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/tierOptionalChip"
                    style="@style/Statistics.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/day_tier_optional" />
            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

            <LinearLayout
                android:id="@+id/filtersActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetFiltersButton"
                    style="@style/Statistics.FilterResetButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/statistics_filters_reset" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/applyFiltersButton"
                    style="@style/Statistics.FilterActionButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/statistics_filters_apply" />
            </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
