<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/color_picker_sheet_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:background="@drawable/color_picker_sheet_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/custom_color_picker_title"
                android:textColor="?attr/colorPickerOnSurface"
                android:fontFamily="sans-serif-medium"
                android:textSize="21sp"
                android:textStyle="normal" />

            <ImageButton
                android:id="@+id/custom_color_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/color_picker_close_background"
                android:contentDescription="@string/custom_color_close"
                android:padding="11dp"
                android:src="@drawable/ic_action_cancel"
                app:tint="?attr/colorPickerOnSurface" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/custom_color_preview"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/custom_color_preview_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|bottom"
                android:layout_margin="16dp"
                android:background="@drawable/color_picker_hex_badge"
                android:fontFamily="monospace"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/custom_color_tabs"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/color_picker_tabs_background"
            app:tabIndicator="@drawable/color_picker_tab_indicator"
            app:tabIndicatorColor="?attr/colorPickerSurface"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorGravity="stretch"
            app:tabMode="fixed"
            app:tabRippleColor="?attr/colorPickerBorder"
            app:tabSelectedTextColor="?attr/colorPickerOnSurface"
            app:tabTextAppearance="@style/ColorPicker.TabText"
            app:tabTextColor="?attr/colorPickerOnSurfaceVariant">

            <com.google.android.material.tabs.TabItem android:text="@string/custom_color_tab_hex" />
            <com.google.android.material.tabs.TabItem android:text="@string/custom_color_tab_hsv" />
            <com.google.android.material.tabs.TabItem android:text="@string/custom_color_tab_rgb" />
        </com.google.android.material.tabs.TabLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:id="@+id/custom_color_hex_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/custom_color_code"
                    android:textColor="?attr/colorPickerOnSurfaceVariant"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/custom_color_hex_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint=""
                    app:boxBackgroundColor="?attr/colorPickerSurface"
                    app:boxStrokeColor="?attr/colorPickerBorder"
                    app:errorTextColor="?attr/colorPickerDanger"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/custom_color_hex_input"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:digits="0123456789ABCDEFabcdef#"
                        android:fontFamily="monospace"
                        android:inputType="textCapCharacters|textNoSuggestions"
                        android:maxLength="7"
                        android:singleLine="true"
                        android:textColor="?attr/colorPickerOnSurface"
                        android:textSize="18sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/custom_color_hsv_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include layout="@layout/custom_color_hsv_controls" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/custom_color_rgb_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include layout="@layout/custom_color_rgb_controls" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/custom_color_cancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:alpha="1"
                android:background="@null"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0"
                android:text="@string/color_picker_cancel"
                android:textAllCaps="false"
                android:textColor="?attr/colorPickerOnSurface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/custom_color_done"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@null"
                android:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/pomodoro_done"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="normal"
                android:translationZ="0dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
