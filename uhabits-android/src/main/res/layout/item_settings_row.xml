<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/rowIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="12dp"
            android:tint="?attr/contrast60"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_gravity="center_vertical">

            <TextView
                android:id="@+id/rowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="?attr/contrast100" />

            <TextView
                android:id="@+id/rowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="?attr/contrast60"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="1dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/accessoryContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_gravity="center_vertical">

            <ImageView
                android:id="@+id/accessoryChevron"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="?attr/contrast40"
                android:visibility="gone"
                android:contentDescription="@null" />

            <org.isoron.uhabits.activities.settings.SettingsSwitchView
                android:id="@+id/accessorySwitch"
                android:layout_width="42dp"
                android:layout_height="24dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/accessoryValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="?attr/contrast60"
                android:visibility="gone" />

            <View
                android:id="@+id/accessoryColorSwatch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:id="@+id/rowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/contrast20" />
</LinearLayout>
