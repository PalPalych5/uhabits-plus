<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.habits.edit.EditHabitActivity">

    <!-- Modern Native Compose Screen Host -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeFormView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Hidden compatibility layer preserving View IDs and contract for instrumentation tests -->
    <LinearLayout
        android:id="@+id/compatLayer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/buttonSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </androidx.appcompat.widget.Toolbar>

        <EditText android:id="@+id/nameInput" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <Button android:id="@+id/colorButton" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <EditText android:id="@+id/questionInput" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <EditText android:id="@+id/notesInput" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <FrameLayout android:id="@+id/unitOuterBox" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <EditText android:id="@+id/unitInput" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </FrameLayout>
        <FrameLayout android:id="@+id/targetOuterBox" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <EditText android:id="@+id/targetInput" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </FrameLayout>
        <TextView android:id="@+id/numericalFrequencyPicker" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <FrameLayout android:id="@+id/targetTypeOuterBox" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:id="@+id/targetTypePicker" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </FrameLayout>
        <FrameLayout android:id="@+id/frequencyOuterBox" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:id="@+id/boolean_frequency_picker" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </FrameLayout>
        <FrameLayout android:id="@+id/dayTierOuterBox" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:id="@+id/dayTierPicker" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </FrameLayout>
        <FrameLayout android:id="@+id/habitBlockOuterBox" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:id="@+id/habitBlockPicker" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </FrameLayout>
        <FrameLayout android:id="@+id/iconOuterBox" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:id="@+id/iconPicker" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </FrameLayout>
        <FrameLayout android:id="@+id/timerEnabledOuterBox" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/timerEnabledSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </FrameLayout>
        <FrameLayout android:id="@+id/focusCreditOuterBox" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:id="@+id/focusSourcePicker" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/focusDescendantsSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </FrameLayout>
        <TextView android:id="@+id/reminderTimePicker" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <View android:id="@+id/reminderDivider" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/reminderDatePicker" android:layout_width="wrap_content" android:layout_height="wrap_content" />

    </LinearLayout>

</FrameLayout>
