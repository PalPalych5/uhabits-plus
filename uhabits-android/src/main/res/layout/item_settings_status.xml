<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/settings_status_min_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/settings_detail_padding_start"
        android:paddingTop="@dimen/settings_detail_padding_vertical"
        android:paddingEnd="@dimen/settings_detail_padding_end"
        android:paddingBottom="@dimen/settings_detail_padding_vertical">

        <ImageView
            android:id="@+id/statusIcon"
            android:layout_width="@dimen/settings_detail_icon_size"
            android:layout_height="@dimen/settings_detail_icon_size"
            android:layout_marginEnd="@dimen/settings_detail_icon_gap"
            android:contentDescription="@null"
            android:tint="?attr/contrast60" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statusTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/statusSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="13sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/statusProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:visibility="invisible" />
    </LinearLayout>

    <View
        android:id="@+id/rowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/settings_detail_row_divider_start"
        android:layout_marginEnd="@dimen/settings_detail_divider_end" />
</LinearLayout>
